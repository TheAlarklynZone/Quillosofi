---
import '../styles/global.css';
import favicon from '../../QuillosofiICO.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Quillosofi — Write Without Choosing',
  description = 'A free, open-source writing app for authors and worldbuilders. One document, two views, one toggle.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-RY9TDC47VL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-RY9TDC47VL');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content="Quillosofi" />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href={favicon.src} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oldenburg&family=Inter:wght@300;400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>
