---
---

<section id="how-it-works">
  <div class="section-inner">
    <div class="section-header reveal">
      <p class="section-eyebrow">The workflow</p>
      <h2>One document.<br>Two views.</h2>
      <div class="chalk-rule"></div>
    </div>
    <div class="steps">

      <div class="step reveal">
        <div class="step-copy">
          <div class="step-number">01</div>
          <h3>Create a Canvas</h3>
          <p class="step-lead">Start a new canvas inside any Space. Give it an emoji, pick a cover gradient, and start writing.</p>
          <p class="step-detail">Canvases are organized in Spaces &mdash; your worldbuilding saga, your short fiction, your research notes. Each canvas keeps its own content, settings, and Quillginate state independently.</p>
        </div>
        <div class="step-visual">
          <div class="mini-window">
            <div class="mini-titlebar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
            <div class="mini-body" style="padding:16px">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
                <div style="width:32px;height:32px;border-radius:8px;background:rgba(74,122,74,0.2);border:1px solid rgba(157,186,157,0.2);display:flex;align-items:center;justify-content:center;font-size:14px">&#x1f4d6;</div>
                <div><div style="height:10px;background:rgba(157,186,157,0.3);border-radius:4px;width:120px;margin-bottom:6px"></div><div style="height:7px;background:rgba(157,186,157,0.15);border-radius:4px;width:80px"></div></div>
              </div>
              <div style="font-size:10px;color:rgba(157,186,157,0.4);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px">Choose a cover</div>
              <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:4px">
                <div style="height:28px;border-radius:4px;background:linear-gradient(135deg,#131f17,#0a1209);border:1px solid rgba(157,186,157,0.1)"></div>
                <div style="height:28px;border-radius:4px;background:linear-gradient(135deg,#1a3020,#131f17);border:2px solid rgba(74,122,74,0.6)"></div>
                <div style="height:28px;border-radius:4px;background:linear-gradient(135deg,#1c1c1a,#131f17);border:1px solid rgba(157,186,157,0.1)"></div>
                <div style="height:28px;border-radius:4px;background:linear-gradient(135deg,#151c1a,#0f1c14);border:1px solid rgba(157,186,157,0.1)"></div>
                <div style="height:28px;border-radius:4px;background:linear-gradient(135deg,#1a1a17,#131f17);border:1px solid rgba(157,186,157,0.1)"></div>
                <div style="height:28px;border-radius:4px;background:linear-gradient(135deg,#171717,#0f1c14);border:1px solid rgba(157,186,157,0.1)"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="step step-reverse reveal">
        <div class="step-copy">
          <div class="step-number">02</div>
          <h3>Write in Quillscript</h3>
          <p class="step-lead">The default mode: one editor, continuous scroll, Notion-style page header. Just write.</p>
          <p class="step-detail">Cross-page selection works natively because there&rsquo;s only one editor per canvas. Format with the top toolbar or keyboard shortcuts.</p>
        </div>
        <div class="step-visual">
          <div class="mini-window">
            <div class="mini-titlebar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <div style="margin-left:auto"><div class="mode-badge" style="font-size:9px;padding:2px 8px">Quillscript</div></div>
            </div>
            <div class="mini-body" style="padding:14px">
              <div style="font-family:'Oldenburg',serif;font-size:13px;color:rgba(212,224,212,0.8);margin-bottom:10px">The Alarklyn Shore</div>
              <div style="height:2px;background:linear-gradient(90deg,transparent,rgba(74,122,74,0.4),transparent);margin-bottom:10px"></div>
              <div class="tl" style="width:100%"></div>
              <div class="tl" style="width:88%;margin-top:4px"></div>
              <div class="tl" style="width:100%;margin-top:4px"></div>
              <div class="tl" style="width:75%;margin-top:4px"></div>
              <div class="tl" style="width:95%;margin-top:4px"></div>
              <div class="tl" style="width:60%;margin-top:4px"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="step reveal">
        <div class="step-copy">
          <div class="step-number">03</div>
          <h3>Flip to Quillginate</h3>
          <p class="step-lead">When you want to review layout, hit the toggle. Same document &mdash; now in paginated page frames.</p>
          <p class="step-detail">The paginator splits your document into pages with a Word-style ruler, spread mode, and an outline rail. Add hard page breaks (Mod-Enter) that the paginator respects. Flip back anytime &mdash; zero data loss.</p>
        </div>
        <div class="step-visual">
          <div class="mini-window">
            <div class="mini-titlebar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <div style="margin-left:4px;font-size:9px;color:rgba(157,186,157,0.4)">Page 1 / 2</div>
              <div style="margin-left:auto"><div class="mode-badge" style="font-size:9px;padding:2px 8px;background:rgba(74,122,74,0.3);border-color:rgba(74,122,74,0.5)">Quillginate ON</div></div>
            </div>
            <div class="mini-body" style="padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
              <div style="border:1px solid rgba(157,186,157,0.1);border-radius:4px;padding:8px;background:rgba(10,18,9,0.6)">
                <div style="font-size:8px;color:rgba(157,186,157,0.3);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Page 1</div>
                <div class="tl" style="width:100%"></div>
                <div class="tl" style="width:80%;margin-top:4px"></div>
                <div class="tl" style="width:90%;margin-top:4px"></div>
                <div style="display:flex;align-items:center;gap:4px;margin:6px 0"><div style="flex:1;border-top:1px dashed rgba(157,186,157,0.2)"></div><span style="font-size:7px;color:rgba(157,186,157,0.25)">Break</span><div style="flex:1;border-top:1px dashed rgba(157,186,157,0.2)"></div></div>
              </div>
              <div style="border:1px solid rgba(157,186,157,0.1);border-radius:4px;padding:8px;background:rgba(10,18,9,0.6)">
                <div style="font-size:8px;color:rgba(157,186,157,0.3);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Page 2</div>
                <div class="tl" style="width:100%"></div>
                <div class="tl" style="width:70%;margin-top:4px"></div>
                <div class="tl" style="width:85%;margin-top:4px"></div>
                <div class="tl" style="width:55%;margin-top:4px"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
