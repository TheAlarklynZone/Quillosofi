---
const features = [
  {
    icon: '<rect x="3" y="3" width="8" height="18" rx="1"/><rect x="13" y="3" width="8" height="18" rx="1"/>',
    title: 'Two Views, One Document',
    body: 'Quillscript gives you Notion-style continuous scroll. Flip the toggle and Quillginate renders the same content in paginated page frames. No data duplication, no export step.',
  },
  {
    icon: '<path d="M4 6h16M4 12h16M4 18h10"/>',
    title: 'Quillscript',
    body: 'A single Tiptap editor instance per canvas. Cross-page selection works natively. Notion-style page header with emoji, cover gradient, and Oldenburg serif title.',
  },
  {
    icon: '<path d="M2 5h20v14H2z"/><path d="M6 3v2M18 3v2M6 19v2M18 19v2"/>',
    title: 'Quillginate',
    body: 'Word-style ruler, indent markers, hard page breaks (Mod-Enter), spread mode, outline rail, and a paginator that auto-reflows as you type. Designed for layout review.',
  },
  {
    icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
    title: 'Spaces & Canvases',
    body: 'Organize your writing in Spaces — groups of canvases with drag-reorder, double-click rename, emoji picker, and twelve chalkboard cover gradients.',
  },
  {
    icon: '<path d="M21.5 2v6h-6"/><path d="M2.5 12A10 10 0 0 1 21.5 8"/><path d="M2.5 22v-6h6"/><path d="M21.5 12A10 10 0 0 1 2.5 16"/>',
    title: 'Real Auto-Updates',
    body: 'electron-updater with alpha and beta channels. Download progress, in-session install prompt with countdown, per-version dismissal. No silent close-and-reinstall.',
  },
  {
    icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>',
    title: 'Full Data Export',
    body: 'Export your canvases as DOCX or PDF from Settings. Your writing is yours — no lock-in, no proprietary formats hidden behind a paywall.',
  },
];
---

<section id="features">
  <div class="section-inner">
    <div class="section-header reveal">
      <p class="section-eyebrow">What it does</p>
      <h2>Everything you need.<br>Nothing you don&rsquo;t.</h2>
      <div class="chalk-rule"></div>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card reveal">
          <div class="feature-icon" set:html={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">${f.icon}</svg>`} />
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.feature-card').forEach((el, i) => {
    (el as HTMLElement).dataset.delay = String(i * 80);
  });
</script>
