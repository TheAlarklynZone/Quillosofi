---
import heroLogo from '../../QuillosofiICO.svg';

const githubUrl = 'https://github.com/TheAlarklynZone/Quillosofi';
---

<section id="hero">
  <div class="hero-rings" aria-hidden="true">
    <div class="ring ring-1"></div>
    <div class="ring ring-2"></div>
    <div class="glow-blob glow-1"></div>
    <div class="glow-blob glow-2"></div>
  </div>
  <div class="hero-inner">
    <div class="hero-copy reveal">
      <div class="hero-logo-lockup">
        <img src={heroLogo.src} alt="Quillosofi" class="hero-logo-img" />
      </div>
      <div class="badge"><span class="badge-dot"></span>Free &amp; Open Source</div>
      <h1>Write Without<br><span class="underline-chalk">Choosing.</span></h1>
      <p class="hero-sub">Notion&rsquo;s continuous scroll. Word&rsquo;s paginated pages.<br>One document, two views, one toggle.</p>
      <p class="hero-detail">Built for authors and worldbuilders who refuse to compromise between writing comfort and print-ready layout.</p>
      <div class="hero-ctas">
        <a href="#download" class="btn btn-primary">Download Free</a>
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path></svg>
          View on GitHub
        </a>
      </div>
      <p class="hero-fine">No accounts. No subscriptions. No paywalls. Ever.<br>This Desktop App is still in Development. <br>Stuff may break, change, or improve over time.</p>
    </div>
    <div class="hero-mockup reveal reveal-delay">
      <div class="mockup-glow" aria-hidden="true"></div>
      <div class="app-window">
        <div class="titlebar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="titlebar-label">Quillosofi</span>
        </div>
        <div class="app-body">
          <div class="sidebar">
            <div class="sidebar-section-label">Spaces</div>
            <div class="sidebar-item active"><span>&#x2694;&#xfe0f;</span> Hibrythian Saga</div>
            <div class="sidebar-item"><span>&#x1f30a;</span> Naiseikai Arc</div>
            <div class="sidebar-item"><span>&#x1f4d6;</span> Chapter Notes</div>
            <div class="sidebar-item"><span>&#x1f5fa;&#xfe0f;</span> World Atlas</div>
          </div>
          <div class="editor-pane">
            <div class="toolbar">
              <button class="tool-btn">B</button>
              <button class="tool-btn"><em>I</em></button>
              <button class="tool-btn"><u>U</u></button>
              <div class="tool-sep"></div>
              <button class="tool-btn small">H1</button>
              <button class="tool-btn small">H2</button>
              <div class="tool-spacer"></div>
              <div class="mode-badge">Quillscript</div>
            </div>
            <div class="canvas-area">
              <div class="canvas-title"><span>&#x2694;&#xfe0f;</span> Chapter I &mdash; The Alarklyn Shore</div>
              <div class="canvas-rule"></div>
              <div class="text-lines">
                <div class="tl" style="width:100%"></div>
                <div class="tl" style="width:83%"></div>
                <div class="tl" style="width:100%"></div>
                <div class="tl" style="width:72%"></div>
                <div class="page-break-line"><div class="pb-rule"></div><span class="pb-label">Page Break</span><div class="pb-rule"></div></div>
                <div class="tl dim" style="width:100%"></div>
                <div class="tl dim" style="width:68%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="float-badge badge-br float-anim"><div class="fb-label">Quillginate</div><div class="fb-value">Page 1 of 3</div></div>
      <div class="float-badge badge-tl float-anim float-anim-2"><div class="fb-label">Words</div><div class="fb-value">2,847</div></div>
    </div>
  </div>
  <a href="#features" class="scroll-hint">
    <span>Explore</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
  </a>
</section>
